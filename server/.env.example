# Hinova SGA API — https://api.hinova.com.br/api/sga/v2/doc/
# Gere o HINOVA_BASE_TOKEN em: SGA > Área Cliente > APIs > Gerenciar APIs
HINOVA_API_URL=https://api.hinova.com.br/api/sga/v2

# Credenciais Hinova — Associação APROVAUTO
HINOVA_BASE_TOKEN=token
HINOVA_USUARIO=user
HINOVA_SENHA=senha

# Credenciais Hinova — Associação CONEXAO (mesmo endpoint, credenciais próprias)
CONEXAO_BASE_TOKEN=token
CONEXAO_USUARIO=user
CONEXAO_SENHA=senha

# JWT
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# PostgreSQL — Railway: cole a connection string gerada no dashboard
# Formato: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/cancelamento
